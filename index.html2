<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HOODLOOP // Cyber Streetwear Collective</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <!-- React & ReactDOM -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <!-- Babel for JSX -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    body {
      font-family: 'Space Grotesk', sans-serif;
      background-color: #0a0a0c;
      color: #f3f4f6;
    }
    .font-orbitron {
      font-family: 'Orbitron', sans-serif;
    }
    .bg-grid-pattern {
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 32px 32px;
    }
    .holo-text {
      background: linear-gradient(135deg, #00f0ff 0%, #7000ff 30%, #ff007a 60%, #e0e0e0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-size: 200% 200%;
      animation: holoShift 6s ease infinite;
    }
    @keyframes holoShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0d0e12;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00f0ff;
    }
  </style>
</head>
<body class="bg-grid-pattern antialiased selection:bg-[#00f0ff] selection:text-black">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    const PRODUCTS = [
      {
        id: 'hdl-holo-tee',
        name: 'HDL Holographic Prism Heavyweight Tee',
        category: 'tees',
        priceUSD: 48,
        pricePHP: 2650,
        badge: 'NEW ARRIVAL // DROP 01',
        isNew: true,
        frontImg: 'https://i.ibb.co/60B8Z7s/hdl-front.png', // Embedded render base
        backImg: 'https://i.ibb.co/Ryp1Y6Q/hdl-back.png',
        description: 'Features a metallic iridescent prism HDL typographic graphic printed on premium heavy cotton. Engineered with dropped shoulders and a boxy vintage silhouette.',
        specs: ['420 GSM Ultra-Heavy Cotton', 'High-Density Prismatic Foil Print', 'Reinforced Boxy Collar', 'Custom HOODLOOP Neck Label'],
        sizes: ['S', 'M', 'L', 'XL', 'XXL']
      },
      {
        id: 'hoodloop-cyber-hoodie',
        name: 'Tactical Cyber Sigil Heavy Hoodie',
        category: 'hoodies',
        priceUSD: 85,
        pricePHP: 4700,
        badge: 'LIMITED EDITION',
        isNew: false,
        frontImg: 'https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=800&q=80',
        backImg: 'https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=800&q=80',
        description: 'Heavy fleece hoodie with reflective metallic cyber sigil prints across chest and sleeves. Oversized hood and hidden side seam pocket.',
        specs: ['500 GSM French Terry Fleece', 'Screenprinted Reflective Accents', 'Deep Dual-Layer Hood', 'Thumbhole Cuffs'],
        sizes: ['M', 'L', 'XL', 'XXL']
      },
      {
        id: 'hoodloop-utility-pant',
        name: 'Signal Utility Modular Cargo Pants',
        category: 'bottoms',
        priceUSD: 78,
        pricePHP: 4300,
        badge: 'BESTSELLER',
        isNew: false,
        frontImg: 'https://images.unsplash.com/photo-1517445312882-bc9910d016b7?auto=format&fit=crop&w=800&q=80',
        backImg: 'https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?auto=format&fit=crop&w=800&q=80',
        description: 'Water-resistant tactical cargo trousers with magnetic buckle straps and expandable knee pockets.',
        specs: ['Ripstop Nylon & Cordura Hybrid', 'Magnetic Fidlock Straps', 'Ankle cinch toggles', '6 Functional Pockets'],
        sizes: ['S', 'M', 'L', 'XL']
      },
      {
        id: 'hoodloop-holotag-cap',
        name: 'HDL Hologram Sigil Snapback Cap',
        category: 'accessories',
        priceUSD: 32,
        pricePHP: 1750,
        badge: 'STAPLE ACCESSORY',
        isNew: false,
        frontImg: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=800&q=80',
        backImg: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=800&q=80',
        description: 'Structured 6-panel hat featuring a 3D metallic embroidery HDL logo and custom branded interior taping.',
        specs: ['100% Heavy Cotton Canvas', '3D Metallic Prism Stitching', 'Adjustable Metal Clasp', 'Inner Sigil Taping'],
        sizes: ['ONE SIZE']
      }
    ];

    function App() {
      const [currency, setCurrency] = useState('USD');
      const [cart, setCart] = useState([]);
      const [isCartOpen, setIsCartOpen] = useState(false);
      const [selectedProduct, setSelectedProduct] = useState(null);
      const [viewMode, setViewMode] = useState({}); // { productId: 'front' | 'back' }
      const [filterCategory, setFilterCategory] = useState('all');
      const [searchQuery, setSearchQuery] = useState('');
      const [showSizeChart, setShowSizeChart] = useState(false);
      const [checkoutSuccess, setCheckoutSuccess] = useState(false);

      useEffect(() => {
        if (window.lucide) {
          window.lucide.createIcons();
        }
      });

      const toggleCurrency = () => {
        setCurrency(prev => prev === 'USD' ? 'PHP' : 'USD');
      };

      const formatPrice = (usd, php) => {
        return currency === 'USD' ? `$${usd}` : `₱${php.toLocaleString()}`;
      };

      const addToCart = (product, size) => {
        const itemKey = `${product.id}-${size}`;
        setCart(prev => {
          const existing = prev.find(item => item.key === itemKey);
          if (existing) {
            return prev.map(item => item.key === itemKey ? { ...item, qty: item.qty + 1 } : item);
          }
          return [...prev, { ...product, key: itemKey, selectedSize: size, qty: 1 }];
        });
        setIsCartOpen(true);
      };

      const updateQty = (key, delta) => {
        setCart(prev => prev.map(item => {
          if (item.key === key) {
            const newQty = item.qty + delta;
            return newQty > 0 ? { ...item, qty: newQty } : null;
          }
          return item;
        }).filter(Boolean));
      };

      const cartTotalUSD = cart.reduce((sum, item) => sum + item.priceUSD * item.qty, 0);
      const cartTotalPHP = cart.reduce((sum, item) => sum + item.pricePHP * item.qty, 0);

      const filteredProducts = PRODUCTS.filter(p => {
        const matchesCategory = filterCategory === 'all' || p.category === filterCategory;
        const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                              p.description.toLowerCase().includes(searchQuery.toLowerCase());
        return matchesCategory && matchesSearch;
      });

      return (
        <div className="min-h-screen flex flex-col justify-between">
          {/* Top Banner */}
          <div className="bg-black/90 border-b border-zinc-800 text-xs py-2 px-4 text-center tracking-widest text-zinc-400 font-orbitron uppercase flex justify-between items-center">
            <span className="hidden md:inline">⚡ FREE EXPRESS SHIPPING ON ORDERS OVER $100 / ₱5,500</span>
            <span className="mx-auto md:mx-0 text-[#00f0ff]">HOODLOOP PROJECT // DROP 01 LIVE</span>
            <button 
              onClick={toggleCurrency}
              className="px-2 py-0.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 rounded text-[10px] font-mono transition"
            >
              CURRENCY: <span className="text-[#00f0ff] font-bold">{currency}</span>
            </button>
          </div>

          {/* Header */}
          <header className="sticky top-0 z-40 bg-[#0a0a0c]/90 backdrop-blur-md border-b border-zinc-800">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
              
              {/* Brand Logo */}
              <a href="#" className="flex items-center gap-2 group">
                <span className="font-orbitron text-2xl font-black tracking-tighter text-white group-hover:text-[#00f0ff] transition">
                  HOODLOOP<span className="text-[#00f0ff]">.</span>
                </span>
                <span className="text-[10px] font-mono uppercase bg-zinc-800 border border-zinc-700 text-zinc-400 px-1.5 py-0.5 rounded">
                  EST. 2026
                </span>
              </a>

              {/* Search Bar */}
              <div className="hidden md:flex items-center relative w-72">
                <input
                  type="text"
                  placeholder="SEARCH CATALOG..."
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                  className="w-full bg-zinc-900 border border-zinc-800 rounded-none py-1.5 pl-8 pr-4 text-xs font-mono text-white placeholder-zinc-500 focus:outline-none focus:border-[#00f0ff]"
                />
                <i data-lucide="search" className="w-4 h-4 text-zinc-500 absolute left-2.5"></i>
              </div>

              {/* Cart Button */}
              <button 
                onClick={() => setIsCartOpen(true)}
                className="relative px-4 py-2 border border-zinc-700 hover:border-[#00f0ff] bg-zinc-900 text-white font-orbitron text-xs tracking-wider flex items-center gap-2 transition group"
              >
                <i data-lucide="shopping-bag" className="w-4 h-4 text-[#00f0ff]"></i>
                <span>CART</span>
                <span className="bg-[#00f0ff] text-black text-[10px] font-bold px-1.5 py-0.2 rounded-full font-mono">
                  {cart.reduce((a, b) => a + b.qty, 0)}
                </span>
              </button>

            </div>
          </header>

          {/* Hero Banner */}
          <div className="relative border-b border-zinc-800 overflow-hidden bg-black py-16 px-6 text-center">
            <div className="absolute inset-0 opacity-20 bg-[radial-gradient(#00f0ff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <div className="relative max-w-3xl mx-auto space-y-4">
              <span className="inline-block px-3 py-1 bg-zinc-900 border border-zinc-700 text-[#00f0ff] text-xs font-mono tracking-widest uppercase">
                FEATURED RELEASE
              </span>
              <h1 className="font-orbitron text-4xl sm:text-6xl font-black tracking-tight text-white uppercase">
                <span className="holo-text">HDL PRISM</span> COLLECTION
              </h1>
              <p className="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto">
                Cyber-inspired silhouettes crafted from heavy 420GSM cotton featuring holographic foil treatments and boxy structural cuts.
              </p>
            </div>
          </div>

          {/* Main Content Area */}
          <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-1 w-full">
            
            {/* Filters Bar */}
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10 pb-6 border-b border-zinc-800">
              <div className="flex flex-wrap gap-2">
                {['all', 'tees', 'hoodies', 'bottoms', 'accessories'].map(cat => (
                  <button
                    key={cat}
                    onClick={() => setFilterCategory(cat)}
                    className={`px-4 py-1.5 text-xs font-orbitron uppercase tracking-wider border transition ${
                      filterCategory === cat
                        ? 'bg-[#00f0ff] text-black border-[#00f0ff] font-bold'
                        : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:border-zinc-600'
                    }`}
                  >
                    {cat}
                  </button>
                ))}
              </div>
              <span className="text-xs font-mono text-zinc-500">
                SHOWING {filteredProducts.length} ITEMS
              </span>
            </div>

            {/* Product Grid */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
              {filteredProducts.map(product => {
                const currentView = viewMode[product.id] || 'front';
                const imageSrc = currentView === 'front' ? product.frontImg : product.backImg;

                return (
                  <div 
                    key={product.id}
                    className="group bg-zinc-950 border border-zinc-800 hover:border-[#00f0ff]/50 transition flex flex-col justify-between"
                  >
                    {/* Top Image Container */}
                    <div className="relative aspect-square bg-zinc-900 overflow-hidden">
                      
                      {/* Product Tag Badge */}
                      <span className="absolute top-3 left-3 z-10 bg-black/80 backdrop-blur-sm border border-zinc-700 text-[#00f0ff] text-[10px] font-mono px-2 py-1 tracking-wider uppercase">
                        {product.badge}
                      </span>

                      {/* Front/Back Toggle Switch */}
                      <div className="absolute top-3 right-3 z-10 flex gap-1 bg-black/80 p-1 border border-zinc-800">
                        <button
                          onClick={() => setViewMode({ ...viewMode, [product.id]: 'front' })}
                          className={`px-2 py-0.5 text-[9px] font-mono uppercase transition ${
                            currentView === 'front' ? 'bg-[#00f0ff] text-black font-bold' : 'text-zinc-400 hover:text-white'
                          }`}
                        >
                          FRONT
                        </button>
                        <button
                          onClick={() => setViewMode({ ...viewMode, [product.id]: 'back' })}
                          className={`px-2 py-0.5 text-[9px] font-mono uppercase transition ${
                            currentView === 'back' ? 'bg-[#00f0ff] text-black font-bold' : 'text-zinc-400 hover:text-white'
                          }`}
                        >
                          BACK
                        </button>
                      </div>

                      {/* Display Image or Custom SVG Graphic */}
                      {product.id === 'hdl-holo-tee' ? (
                        <div className="w-full h-full flex items-center justify-center bg-[#111115] p-6 relative">
                          {/* Simulated Streetwear Mockup */}
                          <div className="relative w-full max-w-[260px] aspect-[4/5] bg-zinc-100 rounded-sm shadow-2xl flex flex-col items-center justify-center p-4">
                            {/* Collar */}
                            <div className="absolute top-0 w-24 h-6 border-b-2 border-zinc-300 rounded-b-full bg-zinc-200"></div>
                            
                            {currentView === 'front' ? (
                              <div className="text-center space-y-1">
                                <h2 className="font-orbitron font-black text-4xl sm:text-5xl tracking-tight holo-text italic">
                                  HDL<span className="text-xs align-super">®</span>
                                </h2>
                                <p className="text-[8px] font-mono text-zinc-500 tracking-widest">HOODLOOP COLLECTIVE</p>
                              </div>
                            ) : (
                              <div className="text-center">
                                <span className="text-[10px] font-mono text-zinc-400 tracking-widest uppercase">
                                  // HEAVYWEIGHT CUT
                                </span>
                              </div>
                            )}
                          </div>
                        </div>
                      ) : (
                        <img 
                          src={imageSrc} 
                          alt={product.name}
                          className="w-full h-full object-cover object-center group-hover:scale-105 transition duration-500"
                        />
                      )}

                      {/* View Details Overlay */}
                      <button 
                        onClick={() => setSelectedProduct(product)}
                        className="absolute inset-x-0 bottom-0 py-2.5 bg-black/90 backdrop-blur-sm border-t border-zinc-800 text-white font-orbitron text-xs tracking-widest opacity-0 group-hover:opacity-100 transition text-center hover:text-[#00f0ff]"
                      >
                        VIEW FULL DETAILS
                      </button>
                    </div>

                    {/* Product Details Info */}
                    <div className="p-5 space-y-3 flex-1 flex flex-col justify-between">
                      <div>
                        <h3 className="font-orbitron text-base font-bold text-white group-hover:text-[#00f0ff] transition">
                          {product.name}
                        </h3>
                        <p className="text-xs text-zinc-400 mt-1 line-clamp-2">
                          {product.description}
                        </p>
                      </div>

                      <div className="pt-2 border-t border-zinc-900 flex items-center justify-between">
                        <span className="font-orbitron text-lg font-bold text-white">
                          {formatPrice(product.priceUSD, product.pricePHP)}
                        </span>

                        {/* Quick Size Selectors */}
                        <div className="flex gap-1">
                          {product.sizes.slice(0, 3).map(size => (
                            <button
                              key={size}
                              onClick={() => addToCart(product, size)}
                              className="w-7 h-7 border border-zinc-800 hover:border-[#00f0ff] hover:bg-[#00f0ff] hover:text-black text-zinc-400 text-[10px] font-mono transition flex items-center justify-center"
                            >
                              {size}
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>

                  </div>
                );
              })}
            </div>

          </main>

          {/* Cart Drawer */}
          {isCartOpen && (
            <div className="fixed inset-0 z-50 overflow-hidden bg-black/80 backdrop-blur-sm flex justify-end">
              <div className="w-full max-w-md bg-zinc-950 border-l border-zinc-800 p-6 flex flex-col justify-between h-full">
                
                {/* Cart Header */}
                <div>
                  <div className="flex items-center justify-between pb-4 border-b border-zinc-800">
                    <h2 className="font-orbitron text-lg font-bold text-white flex items-center gap-2">
                      <i data-lucide="shopping-bag" className="text-[#00f0ff] w-5 h-5"></i>
                      BAG ({cart.length})
                    </h2>
                    <button 
                      onClick={() => setIsCartOpen(false)}
                      className="text-zinc-500 hover:text-white p-1"
                    >
                      <i data-lucide="x" className="w-6 h-6"></i>
                    </button>
                  </div>

                  {/* Free Shipping Tracker */}
                  <div className="my-4 bg-zinc-900 p-3 border border-zinc-800 text-xs font-mono">
                    <div className="flex justify-between text-zinc-400 mb-1.5">
                      <span>FREE SHIPPING PROGRESS</span>
                      <span>
                        {cartTotalUSD >= 100 ? 'QUALIFIED!' : `$${100 - cartTotalUSD} LEFT`}
                      </span>
                    </div>
                    <div className="w-full bg-zinc-800 h-1.5 rounded-full overflow-hidden">
                      <div 
                        className="bg-[#00f0ff] h-full transition-all duration-300" 
                        style={{ width: `${Math.min((cartTotalUSD / 100) * 100, 100)}%` }}
                      ></div>
                    </div>
                  </div>

                  {/* Cart Items List */}
                  <div className="space-y-4 max-h-[50vh] overflow-y-auto pr-1">
                    {cart.length === 0 ? (
                      <div className="text-center py-12 text-zinc-500 font-mono text-xs">
                        YOUR SHOPPING CART IS CURRENTLY EMPTY.
                      </div>
                    ) : (
                      cart.map(item => (
                        <div key={item.key} className="flex gap-4 p-3 bg-zinc-900 border border-zinc-800 items-center">
                          <div className="w-16 h-16 bg-zinc-800 flex-shrink-0 flex items-center justify-center text-xs font-bold font-orbitron text-[#00f0ff]">
                            HDL
                          </div>
                          <div className="flex-1 min-w-0">
                            <h4 className="font-orbitron text-xs font-bold text-white truncate">{item.name}</h4>
                            <p className="text-[10px] font-mono text-zinc-400">SIZE: {item.selectedSize}</p>
                            <p className="text-xs font-bold text-[#00f0ff] mt-1">
                              {formatPrice(item.priceUSD * item.qty, item.pricePHP * item.qty)}
                            </p>
                          </div>
                          <div className="flex items-center border border-zinc-700">
                            <button onClick={() => updateQty(item.key, -1)} className="px-2 py-0.5 text-zinc-400 hover:text-white text-xs">-</button>
                            <span className="px-2 py-0.5 text-xs font-mono bg-zinc-800 text-white">{item.qty}</span>
                            <button onClick={() => updateQty(item.key, 1)} className="px-2 py-0.5 text-zinc-400 hover:text-white text-xs">+</button>
                          </div>
                        </div>
                      ))
                    )}
                  </div>
                </div>

                {/* Cart Footer / Checkout */}
                <div className="pt-4 border-t border-zinc-800 space-y-4">
                  <div className="flex justify-between items-center font-orbitron text-base font-bold text-white">
                    <span>SUBTOTAL</span>
                    <span className="text-[#00f0ff]">{formatPrice(cartTotalUSD, cartTotalPHP)}</span>
                  </div>

                  <button 
                    disabled={cart.length === 0}
                    onClick={() => {
                      setCheckoutSuccess(true);
                      setCart([]);
                    }}
                    className="w-full py-3 bg-[#00f0ff] text-black font-orbitron font-bold text-sm tracking-widest hover:bg-cyan-300 disabled:opacity-50 disabled:cursor-not-allowed transition"
                  >
                    CHECKOUT NOW
                  </button>
                </div>

              </div>
            </div>
          )}

          {/* Checkout Modal */}
          {checkoutSuccess && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md">
              <div className="bg-zinc-950 border border-[#00f0ff] p-8 max-w-md w-full text-center space-y-4">
                <i data-lucide="check-circle" className="w-12 h-12 text-[#00f0ff] mx-auto"></i>
                <h3 className="font-orbitron text-2xl font-black text-white">ORDER CONFIRMED</h3>
                <p className="text-xs text-zinc-400 font-mono">
                  Your simulated purchase for HOODLOOP gear was successfully logged. Check your email for tracking details.
                </p>
                <button 
                  onClick={() => setCheckoutSuccess(false)}
                  className="px-6 py-2 bg-[#00f0ff] text-black font-orbitron font-bold text-xs"
                >
                  BACK TO STORE
                </button>
              </div>
            </div>
          )}

          {/* Footer */}
          <footer className="border-t border-zinc-800 bg-black py-12 px-6">
            <div className="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-6 text-zinc-500 text-xs font-mono">
              <div>
                <p className="font-orbitron text-white text-sm font-bold">HOODLOOP COLLECTIVE</p>
                <p className="mt-1">© 2026 HOODLOOP. ALL RIGHTS RESERVED.</p>
              </div>
              <div className="flex gap-6">
                <a href="#" className="hover:text-[#00f0ff]">INSTAGRAM</a>
                <a href="#" className="hover:text-[#00f0ff]">TIKTOK</a>
                <a href="#" className="hover:text-[#00f0ff]">DISCORD</a>
              </div>
            </div>
          </footer>

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
